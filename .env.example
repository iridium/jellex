# Copy to .env and fill in. jellex reads .env from its working directory;
# docker compose reads it too. Real environment variables take precedence.

# Jellyfin server jellex sits in front of (required).
JELLYFIN_URL=http://localhost:8096
# API key from the Jellyfin dashboard > API Keys (required).
# For the dev stack, scripts/dev-jellyfin-setup.sh writes this for you.
JELLYFIN_API_KEY=

# Jellyfin user every Plex client acts as. Empty means the first admin.
JELLYFIN_USER=

# Name Plex apps show for this server.
JELLEX_SERVER_NAME=jellex
# Listen address. Plex clients expect port 32400.
JELLEX_LISTEN_ADDR=:32400
# Server identity. Empty derives a stable one from the Jellyfin server ID.
JELLEX_MACHINE_ID=

# Where jellex keeps state (ID map, plex.tv claim) and the downloaded Plex
# Web client. Empty uses the user config and cache directories.
JELLEX_DATA_DIR=
JELLEX_WEB_DIR=

# Serve Plex Web exactly as shipped, without the jellex favicon and wordmark.
JELLEX_DISABLE_CUSTOM_ASSETS=false

# Experimental: URLs published to plex.tv so Plex apps can find jellex,
# comma-separated, and a one-time claim token from https://plex.tv/claim.
JELLEX_PUBLISH_URLS=
PLEX_CLAIM=

# Dev only: make plain `docker compose` use the dev stack.
# COMPOSE_FILE=compose.dev.yaml
