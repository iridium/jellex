// Cloudflare Workers deploy, static assets only: no worker script runs.
// adapter-static writes the site to build/; any path that isn't a file gets
// index.html, the SPA fallback.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "jellex",
	"compatibility_date": "2026-10-06",
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "build",
		"not_found_handling": "single-page-application"
	}
}
