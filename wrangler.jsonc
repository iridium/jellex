// Cloudflare Workers deploy for the SvelteKit build (adapter-cloudflare):
// the worker plus the client assets in .svelte-kit/cloudflare.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "jellex",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-06",
	"observability": {
		"enabled": true
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	}
}
